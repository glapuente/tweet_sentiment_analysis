# infrastructure variables
## Kafka cluster variables
KAFKA_TOPIC=social_media_messages
KAFKA_HOST=kafka-analytics  # to run locally against the Docker container use "localhost"; if Docker use "kafka-analytics" instead
KAFKA_PORT=9093  # to run locally against the Docker container use 9092; if Docker use 9093 instead

## external PostgreSQL variables
POSTGRES_HOST=postgres-analytics
POSTGRES_DB=analytics
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_TABLE_NAME=tweets
